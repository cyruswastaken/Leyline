// Leyline on Azure (Phase 8). Deploy with infra/deploy.ps1; see docs/DEPLOYMENT.md.
//
// Two resource groups on purpose:
//   rg-leyline      (already exists) holds the Azure OpenAI account. Only the two model
//                   deployments are added there; an idle account costs nothing.
//   rg-leyline-app  (created here) holds everything that costs money while it runs, so
//                   `infra/teardown.ps1` can delete it in one step.
targetScope = 'subscription'

@description('Region for everything created here. Your Azure for Students policy allows centralindia, eastasia, uaenorth, koreacentral and malaysiawest.')
param location string = 'koreacentral'

@description('The resource group that holds the disposable resources (created if missing).')
param appResourceGroupName string = 'rg-leyline-app'

@description('The existing resource group and Azure OpenAI account.')
param openAiResourceGroupName string = 'rg-leyline'
param openAiAccountName string = 'leyline-openai'

@description('Chat model deployment. gpt-5.4-mini follows the citation and refusal instructions well at a low price.')
param chatModel string = 'gpt-5.4-mini'
param chatModelVersion string = '2026-03-17'
@description('Capacity in thousands of tokens per minute (GlobalStandard).')
param chatCapacity int = 50

param embeddingModel string = 'text-embedding-3-small'
param embeddingModelVersion string = '1'
param embeddingCapacity int = 50

@description('Postgres administrator password. Generated by deploy.ps1, never stored in a file.')
@secure()
param postgresAdminPassword string

@description('Deploy the web app, worker and task job. Leave false for the first pass (infrastructure only), then push the image and run again with true.')
param deployApps bool = false

@description('Full image reference in the registry, for example leylineacrxxxxxx.azurecr.io/leyline:20261110. Required when deployApps is true.')
param appImage string = ''

@description('Microsoft Entra application (client) id for sign-in. Required when deployApps is true.')
param oidcClientId string = ''
@description('Entra tenant id, used to build the OpenID Connect discovery URL.')
param oidcTenantId string = ''
@secure()
param oidcClientSecret string = ''
@description('JSON object mapping Entra group object ids to the group names documents use, from infra/entra.ps1. Object ids are identifiers, not secrets.')
param oidcGroupNames string = '{}'

@description('Keep one web replica running (true) or let it scale to zero when idle (false, cheaper but the first request is slow).')
param webAlwaysOn bool = true

param tags object = {
  project: 'leyline'
  'delete-with': appResourceGroupName
}

var suffix = substring(uniqueString(subscription().subscriptionId, appResourceGroupName), 0, 6)

resource appRg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: appResourceGroupName
  location: location
  tags: tags
}

module platform 'modules/platform.bicep' = {
  scope: appRg
  name: 'platform'
  params: {
    location: location
    suffix: suffix
    tags: tags
  }
}

module data 'modules/data.bicep' = {
  scope: appRg
  name: 'data'
  params: {
    location: location
    suffix: suffix
    tags: tags
    postgresAdminPassword: postgresAdminPassword
  }
}

module openai 'modules/openai.bicep' = {
  scope: resourceGroup(openAiResourceGroupName)
  name: 'openai'
  params: {
    accountName: openAiAccountName
    chatModel: chatModel
    chatModelVersion: chatModelVersion
    chatCapacity: chatCapacity
    embeddingModel: embeddingModel
    embeddingModelVersion: embeddingModelVersion
    embeddingCapacity: embeddingCapacity
  }
}

// A separate step that waits for both deployments, then reads the key.
module openaiKey 'modules/openai-key.bicep' = {
  scope: resourceGroup(openAiResourceGroupName)
  name: 'openai-key'
  params: { accountName: openAiAccountName }
  dependsOn: [openai]
}

module secrets 'modules/secrets.bicep' = {
  scope: appRg
  name: 'secrets'
  params: {
    keyVaultName: platform.outputs.keyVaultName
    storageAccountName: platform.outputs.storageAccountName
    redisName: data.outputs.redisName
    postgresHost: data.outputs.postgresHost
    postgresAdminPassword: postgresAdminPassword
    openAiKey: openaiKey.outputs.apiKey
    oidcClientSecret: oidcClientSecret
    includeOidcSecret: deployApps
  }
}

module apps 'modules/apps.bicep' = {
  scope: appRg
  name: 'apps'
  params: {
    location: location
    tags: tags
    deployApps: deployApps
    appImage: appImage
    logAnalyticsName: platform.outputs.logAnalyticsName
    identityId: platform.outputs.identityId
    registryServer: platform.outputs.registryServer
    keyVaultUri: platform.outputs.keyVaultUri
    openAiEndpoint: openai.outputs.endpoint
    chatDeployment: openai.outputs.chatDeployment
    embeddingDeployment: openai.outputs.embeddingDeployment
    oidcClientId: oidcClientId
    oidcGroupNames: oidcGroupNames
    oidcMetadataUrl: '${environment().authentication.loginEndpoint}${oidcTenantId}/v2.0/.well-known/openid-configuration'
    webAlwaysOn: webAlwaysOn
  }
  dependsOn: [secrets]
}

output appResourceGroup string = appRg.name
output registryServer string = platform.outputs.registryServer
output keyVaultName string = platform.outputs.keyVaultName
output environmentDefaultDomain string = apps.outputs.defaultDomain
output webUrl string = apps.outputs.webUrl
output postgresHost string = data.outputs.postgresHost
output chatDeployment string = openai.outputs.chatDeployment
output embeddingDeployment string = openai.outputs.embeddingDeployment
